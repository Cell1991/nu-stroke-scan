        <mxCell id="be_f2" edge="1" parent="1" source="be_resnet" target="m_vcanet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="505" />
              <mxPoint x="635" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="be_f3" edge="1" parent="1" source="be_resnet" target="m_patcher" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="505" />
              <mxPoint x="995" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="be_f4" edge="1" parent="1" source="be_resnet" target="m_maxvit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="505" />
              <mxPoint x="1370" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Join 3 Segmentation Models into SciPy -->
        <mxCell id="be_j1" edge="1" parent="1" source="m_dlka" target="be_scipy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="275" y="670" />
              <mxPoint x="635" y="670" />
            </Array>
          </mxGeometry>
