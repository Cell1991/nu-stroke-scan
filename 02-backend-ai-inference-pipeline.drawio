<mxfile host="Electron" pages="1">
  <diagram id="backend-ai-clean" name="Backend and AI Inference Pipeline">
    <mxGraphModel dx="1650" dy="1150" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer Swimlane -->
        <mxCell id="be_swimlane" value="Backend &amp; AI Inference Pipeline (FastAPI, PyTorch &amp; SciPy)" style="swimlane;whiteSpace=wrap;html=1;startSize=60;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;collapsible=0;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="1560" height="990" as="geometry" />
        </mxCell>

        <!-- Row 1: FastAPI Upload Endpoint -->
        <mxCell id="be_endpoint" value="FastAPI Analysis Endpoint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="450" y="135" width="460" height="75" as="geometry" />
        </mxCell>

        <!-- Row 2: Radiologic Heuristic Guardrails -->
        <mxCell id="be_heuristics" value="Radiologic Heuristic Guardrails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="450" y="265" width="460" height="75" as="geometry" />
        </mxCell>

        <!-- Row 3: ResNet-18 Modality Screener -->
        <mxCell id="be_resnet" value="ResNet-18 Modality Screener" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="450" y="395" width="460" height="75" as="geometry" />
        </mxCell>

        <!-- Right Rejection Box -->
        <mxCell id="be_reject" value="Invalid Scan Rejection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="1140" y="330" width="380" height="75" as="geometry" />
        </mxCell>

        <!-- Row 4: 4 Parallel Models -->
        <mxCell id="m_dlka" value="D-LKA Net&#xa;Segmentation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="120" y="545" width="310" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_vcanet" value="VCA-Net&#xa;Segmentation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="480" y="545" width="310" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_patcher" value="Patcher SegFormer&#xa;Segmentation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="840" y="545" width="310" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_maxvit" value="MaxViT 3-Class&#xa;Stroke Classifier" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="1200" y="545" width="340" height="90" as="geometry" />
        </mxCell>

        <!-- Row 5: Intracranial & SciPy Noise Filter -->
        <mxCell id="be_scipy" value="Intracranial &amp; SciPy Noise Filter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="405" y="705" width="460" height="80" as="geometry" />
        </mxCell>

        <!-- Row 6: CT Density Harmonizer -->
        <mxCell id="be_harmonize" value="CT Density Attenuation Harmonizer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial,Helvetica,sans-serif;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="580" y="855" width="520" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="be_e1" edge="1" parent="1" source="be_endpoint" target="be_heuristics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
